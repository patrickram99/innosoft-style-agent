# Copia este archivo a .env y ajusta los valores. .env no se versiona.

# Base de datos (PostgreSQL 16 en docker-compose; las pruebas usan SQLite)
DATABASE_URL=postgresql+psycopg2://innosoft:innosoft@localhost:5432/agent_db
POSTGRES_USER=innosoft
POSTGRES_PASSWORD=innosoft
POSTGRES_DB=agent_db

# Token de servicio que comparte el plugin OJS (cabecera Authorization: Bearer)
AGENT_SERVICE_TOKEN=cambia-este-token

# Carpetas
STORAGE_DIR=storage
RULES_DIR=rules/innosoft
RULES_SCHEMA=rules/schema/rule.schema.json

# Gemini (US-15 en adelante; no se usa todavía)
GEMINI_API_KEY=
